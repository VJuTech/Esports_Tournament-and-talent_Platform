generator client {
  provider = "prisma-client-js"
}

model MatchParticipant {
  id        String @id @default(uuid())
  matchId   String
  userId    String
  seed      Int?
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id])
  @@unique([matchId, userId])
}

model MatchResult {
  id            String @id @default(uuid())
  matchId       String
  submittedById String
  approvedById  String?
  scores        Json
  status        String @default("SUBMITTED")
  evidenceUrl   String?
  submittedAt   DateTime @default(now())
  approvedAt    DateTime?
  match         Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy   User @relation("SubmittedResults", fields: [submittedById], references: [id])
  approvedBy    User? @relation("ApprovedResults", fields: [approvedById], references: [id])
  @@index([matchId, status])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  status    String
  joinedAt  DateTime @default(now())
  departedAt DateTime?
  notes     String?
  team      Team @relation(fields: [teamId], references: [id])
  user      User @relation(fields: [userId], references: [id])
  @@index([teamId, status])
  @@index([userId, joinedAt])
}

model ScoutingEvaluation {
  id           String   @id @default(uuid())
  playerId     String
  scoutId      String
  gameId       String?
  tournamentId String?
  rating       Int
  strengths    String?
  concerns     String?
  notes        String?
  visibility   String   @default("INTERNAL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  player       User @relation("EvaluatedPlayer", fields: [playerId], references: [id])
  scout        User @relation("ScoutEvaluations", fields: [scoutId], references: [id])
  game         Game? @relation(fields: [gameId], references: [id])
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  @@index([playerId, createdAt])
}

model SelectionDecision {
  id           String   @id @default(uuid())
  playerId     String
  decisionById String
  cycle        String
  status       String
  criteria     String
  notes        String?
  decidedAt    DateTime @default(now())
  player       User @relation("SelectionCandidate", fields: [playerId], references: [id])
  decisionBy   User @relation("SelectionDecisionMaker", fields: [decisionById], references: [id])
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  tournamentId String?
  @@index([playerId, decidedAt])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  channel     String   @default("EMAIL")
  status      String   @default("QUEUED")
  subject     String
  body        String
  providerId  String?
  attempts    Int      @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id])
  tournament  Tournament? @relation(fields: [tournamentId], references: [id])
  tournamentId String?
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum UserRole {
  PLAYER
  TOURNAMENT_OFFICIAL
  REFEREE
  TOURNAMENT_MANAGER
  SCOUT
  FINANCE_OFFICER
  SUPER_ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  WAITLISTED
  CONFIRMED
  REFUNDED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  VERIFIED
  FAILED
  ABANDONED
  REFUNDED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ParticipationType {
  INDIVIDUAL
  TEAM
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  role          UserRole       @default(PLAYER)
  accountStatus AccountStatus  @default(ACTIVE)
  profileImage   String?
  country        String?
  eligibilityInfo Json?
  scoutStatus    String?
  awards         Json?
  emailVerifiedAt DateTime?
  sessionVersion Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  rankings      Ranking[]
  teamMembers   TeamMember[]
  auditLogs     AuditLog[]
  gameProfiles  GameProfile[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdTournaments Tournament[] @relation("CreatedTournaments")
  scoutingEvaluations ScoutingEvaluation[] @relation("ScoutEvaluations")
  evaluatedBy ScoutingEvaluation[] @relation("EvaluatedPlayer")
  selectionDecisions SelectionDecision[] @relation("SelectionCandidate")
  decidedSelections SelectionDecision[] @relation("SelectionDecisionMaker")
  notifications Notification[]
  matchResultsSubmitted MatchResult[] @relation("SubmittedResults")
  matchResultsApproved MatchResult[] @relation("ApprovedResults")
  matchParticipants MatchParticipant[]
  teamMemberships TeamMembership[]
  managedTeams Team[] @relation("ManagedTeams")
  uploadedImages ImageAsset[] @relation("UploadedImages")
}

model GameProfile {
  id         String   @id @default(uuid())
  userId     String
  gameId     String
  inGameId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  game       Game     @relation(fields: [gameId], references: [id])
  @@unique([userId, gameId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Game {
  id            String       @id @default(uuid())
  name          String       @unique
  slug          String       @unique
  description   String?
  supportedMode String?
  imageUrl      String?
  rulesUrl      String?
  formats       Json?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tournaments Tournament[]
  teams       Team[]
  profiles    GameProfile[]
  scoutingEvaluations ScoutingEvaluation[]
}

model Tournament {
  id                      String            @id @default(uuid())
  code                    String            @unique
  name                    String
  description             String?
  imageUrl                String?
  format                  String
  participationType       ParticipationType @default(INDIVIDUAL)
  entryFee                Decimal           @db.Decimal(12, 2)
  currency                String            @db.VarChar(3)
  registrationOpensAt     DateTime
  registrationDeadline    DateTime
  startsAt                DateTime
  endsAt                  DateTime
  capacity                Int
  eligibilityMinimumAge   Int?
  eligibilityRequirements String?
  scoringRules            String?
  matchDurationMinutes    Int?
  schedulingRules         String?
  reportingRules          String?
  prizeInformation        String?
  refundPolicy            String?
  terms                   String?
  paymentBankName         String?
  paymentAccountName      String?
  paymentAccountNumber    String?
  paymentAccountType      String?
  paymentInstructions     String?
  disputeDeadline         DateTime?
  status                  TournamentStatus @default(DRAFT)
  gameId                  String
  createdById              String
  publishedAt              DateTime?
  nextTournamentNumber     Int               @default(1)
  game                    Game              @relation(fields: [gameId], references: [id])
  createdBy                User              @relation("CreatedTournaments", fields: [createdById], references: [id])
  registrations           Registration[]
  matches                 Match[]
  rankings                Ranking[]
  rulebook                TournamentRulebook?
  timetable               TournamentTimetable?
  stream                  TournamentStream?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  scoutingEvaluations     ScoutingEvaluation[]
  selectionDecisions      SelectionDecision[]
  notifications           Notification[]
  @@index([status, registrationDeadline])
}

model Registration {
  id               String             @id @default(uuid())
  tournamentNumber String?            @unique
  status           RegistrationStatus @default(PENDING)
  userId           String
  tournamentId     String
  paymentId        String?            @unique
  teamId           String?
  feeAmount        Decimal           @db.Decimal(12, 2)
  feeCurrency      String             @db.VarChar(3)
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  user             User               @relation(fields: [userId], references: [id])
  tournament       Tournament         @relation(fields: [tournamentId], references: [id])
  payment          Payment?           @relation(fields: [paymentId], references: [id])
  paymentAttempts  PaymentAttempt[]
  team             Team?              @relation(fields: [teamId], references: [id])
  receipt          Receipt?
  createdAt        DateTime           @default(now())
  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
}

model Payment {
  id                String        @id @default(uuid())
  providerReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  registration      Registration?
}

model PaymentAttempt {
  id                String        @id @default(uuid())
  registrationId    String
  providerReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  provider          String
  status            PaymentStatus @default(PENDING)
  checkoutUrl       String?
  providerPayload   Json?
  failureReason     String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  registration      Registration  @relation(fields: [registrationId], references: [id])
  @@index([registrationId, status])
}

model Receipt {
  id             String       @id @default(uuid())
  receiptNumber  String       @unique
  issuedAt       DateTime     @default(now())
  registrationId String       @unique
  companyName    String?
  companyContact String?
  playerName     String?
  tournamentName String?
  tournamentNumber String?
  description    String?
  amount         Decimal?     @db.Decimal(12, 2)
  currency       String?      @db.VarChar(3)
  paymentDate    DateTime?
  paymentReference String?
  status         String       @default("PAID")
  registration   Registration @relation(fields: [registrationId], references: [id])
  deliveries     ReceiptDeliveryAttempt[]
  adjustments    ReceiptAdjustment[]
}

model ReceiptDeliveryAttempt {
  id          String   @id @default(uuid())
  receiptId   String
  channel     String
  status      String
  recipient   String
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  receipt     Receipt  @relation(fields: [receiptId], references: [id])
  @@index([receiptId, createdAt])
}

model ReceiptAdjustment {
  id          String   @id @default(uuid())
  receiptId   String
  type        String
  reference   String
  amount      Decimal? @db.Decimal(12, 2)
  currency    String?
  reason      String?
  createdAt   DateTime @default(now())
  receipt     Receipt  @relation(fields: [receiptId], references: [id])
}

model Match {
  id           String     @id @default(uuid())
  tournamentId String
  round        Int
  scheduledAt  DateTime?
  status       String     @default("SCHEDULED")
  result       Json?
  bracketPosition Int?
  nextMatchId  String?
  nextMatchSlot Int?
  isEliminator Boolean @default(true)
  nextMatch    Match? @relation("MatchProgression", fields: [nextMatchId], references: [id])
  sourceMatches Match[] @relation("MatchProgression")
  participants MatchParticipant[]
  results      MatchResult[]
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  @@index([tournamentId, round])
  @@index([nextMatchId])
}

model TournamentRulebook {
  id           String @id @default(uuid())
  tournamentId String @unique
  title        String
  content      String
  publishedAt  DateTime?
  updatedAt    DateTime @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TournamentTimetable {
  id           String @id @default(uuid())
  tournamentId String @unique
  publishedAt  DateTime?
  notes        String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TournamentStream {
  id           String @id @default(uuid())
  tournamentId String @unique
  title        String
  sourceUrl    String
  ingestUrl    String?
  provider     String
  status       String @default("OFFLINE")
  isEnabled    Boolean @default(false)
  startedAt    DateTime?
  endedAt      DateTime?
  updatedAt    DateTime @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model ImageAsset {
  id           String   @id @default(uuid())
  fileName     String
  contentType  String
  bytes        Bytes
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation("UploadedImages", fields: [uploadedById], references: [id], onDelete: SetNull)
  @@index([uploadedById, createdAt])
}

model Ranking {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  position     Int
  score        Decimal    @db.Decimal(12, 2)
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  @@unique([tournamentId, userId])
  @@unique([tournamentId, position])
}

model Team {
  id        String       @id @default(uuid())
  name      String       @unique
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id])
  members   TeamMember[]
  registrations Registration[]
  createdAt DateTime     @default(now())
  managerId String?
  manager   User?        @relation("ManagedTeams", fields: [managerId], references: [id])
  memberships TeamMembership[]
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  status String
  team   Team   @relation(fields: [teamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  @@unique([teamId, userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([entity, entityId])
}
