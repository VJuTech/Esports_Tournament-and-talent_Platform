generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  TOURNAMENT_OFFICIAL
  REFEREE
  TOURNAMENT_MANAGER
  SCOUT
  FINANCE_OFFICER
  SUPER_ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  role          UserRole       @default(PLAYER)
  accountStatus AccountStatus  @default(ACTIVE)
  profileImage   String?
  country        String?
  eligibilityInfo Json?
  scoutStatus    String?
  awards         Json?
  emailVerifiedAt DateTime?
  sessionVersion Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  rankings      Ranking[]
  teamMembers   TeamMember[]
  auditLogs     AuditLog[]
  gameProfiles  GameProfile[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model GameProfile {
  id         String   @id @default(uuid())
  userId     String
  gameId     String
  inGameId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  game       Game     @relation(fields: [gameId], references: [id])
  @@unique([userId, gameId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Game {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  isActive    Boolean      @default(true)
  tournaments Tournament[]
  teams       Team[]
  profiles    GameProfile[]
}

model Tournament {
  id                   String            @id @default(uuid())
  code                 String            @unique
  name                 String
  description          String?
  format               String
  entryFee             Decimal           @db.Decimal(12, 2)
  registrationDeadline DateTime
  startsAt             DateTime
  capacity             Int
  status               TournamentStatus @default(DRAFT)
  gameId               String
  game                 Game              @relation(fields: [gameId], references: [id])
  registrations        Registration[]
  matches              Match[]
  rankings             Ranking[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  @@index([status, registrationDeadline])
}

model Registration {
  id               String             @id @default(uuid())
  tournamentNumber String             @unique
  status           RegistrationStatus @default(PENDING)
  userId           String
  tournamentId     String
  paymentId        String?            @unique
  user             User               @relation(fields: [userId], references: [id])
  tournament       Tournament         @relation(fields: [tournamentId], references: [id])
  payment          Payment?           @relation(fields: [paymentId], references: [id])
  receipt          Receipt?
  createdAt        DateTime           @default(now())
  @@unique([tournamentId, userId])
}

model Payment {
  id                String        @id @default(uuid())
  providerReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  registration      Registration?
}

model Receipt {
  id             String       @id @default(uuid())
  receiptNumber  String       @unique
  issuedAt       DateTime     @default(now())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id])
}

model Match {
  id           String     @id @default(uuid())
  tournamentId String
  round        Int
  scheduledAt  DateTime?
  status       String
  result       Json?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  @@index([tournamentId, round])
}

model Ranking {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  position     Int
  score        Decimal    @db.Decimal(12, 2)
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  @@unique([tournamentId, userId])
  @@unique([tournamentId, position])
}

model Team {
  id        String       @id @default(uuid())
  name      String       @unique
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id])
  members   TeamMember[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  status String
  team   Team   @relation(fields: [teamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  @@unique([teamId, userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([entity, entityId])
}
