<%- include('../partials/dashboard-header', { title, active: 'tournaments' }) %>
<a class="back-link" href="/tournaments/<%= match.tournament.id %>/standings">← Official standings</a>
<section class="page-intro page-intro-small"><span class="eyebrow"><%= match.tournament.game.name %> · Round <%= match.round %></span><h1>Match <%= match.id.slice(0, 8).toUpperCase() %></h1><p><%= match.status %> · <%= match.scheduledAt ? match.scheduledAt.toLocaleString() : 'Schedule pending' %></p></section>
<section class="detail-panel"><h2>Participants</h2><div class="participant-list"><% match.participants.forEach((participant) => { %><div class="participant-row"><strong><%= participant.user.displayName %></strong><span><%= match.result?.[participant.userId] ?? 'Awaiting score' %></span></div><% }) %></div></section>
<% if (currentUser && ['TOURNAMENT_OFFICIAL', 'REFEREE', 'TOURNAMENT_MANAGER', 'SUPER_ADMIN'].includes(currentUser.role)) { %>
<section class="detail-panel"><h2>Submit official result</h2><form class="form-grid" method="post" action="/matches/<%= match.id %>/result"><label>Scores as JSON<input name="scores" placeholder='{"player-id":"3","other-player-id":"1"}' required></label><label>Evidence URL (optional)<input name="evidenceUrl" type="url"></label><button class="button" type="submit">Submit for review</button></form></section>
<% } %>
<% const pending = match.results.find((result) => result.status === 'SUBMITTED'); if (pending && currentUser && ['TOURNAMENT_OFFICIAL', 'TOURNAMENT_MANAGER', 'SUPER_ADMIN'].includes(currentUser.role)) { %><section class="detail-panel"><h2>Review submitted result</h2><p class="muted">Submitted by <%= pending.submittedBy.displayName %> on <%= pending.submittedAt.toLocaleString() %>.</p><form method="post" action="/matches/<%= match.id %>/approve"><button class="button" type="submit">Verify result and recalculate standings</button></form></section><% } %>
<%- include('../partials/dashboard-footer') %>
