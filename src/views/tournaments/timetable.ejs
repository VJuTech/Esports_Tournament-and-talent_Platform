<%- include('../partials/dashboard-header', { title, active: 'tournaments' }) %>
<a class="back-link" href="/tournaments/<%= tournament.id %>/bracket">← Official draw</a>
<section class="page-intro page-intro-small"><span class="eyebrow"><%= tournament.game.name %> · <%= timetablePublished ? 'Published timetable' : 'Tournament timetable' %></span><h1><%= tournament.name %></h1><p><%= tournament.timetable?.notes || 'Check this page for official fixture times and arrival instructions.' %></p></section>
<section class="timetable-list"><% if (!timetablePublished) { %><div class="dashboard-empty"><strong>The timetable has not been published yet.</strong><p>The tournament organizer will publish fixture times here when they are ready.</p></div><% } else if (!tournament.matches.length) { %><div class="dashboard-empty"><strong>Fixtures are being prepared.</strong><p>The operator will publish match times after completing the draw.</p></div><% } else { tournament.matches.forEach((match) => { %><article class="timetable-row"><div><span class="eyebrow">Round <%= match.round %> · <%= match.status.replaceAll('_', ' ') %></span><h2><%= match.participants.map((participant) => participant.user.displayName).join(' vs ') || 'Players to be confirmed' %></h2></div><div><strong><%= match.scheduledAt ? match.scheduledAt.toLocaleString() : 'Time to be confirmed' %></strong><a href="/matches/<%= match.id %>">View fixture →</a></div></article><% }) } %></section>
<%- include('../partials/dashboard-footer') %>
