<%- include('../partials/dashboard-header', { title, active: 'tournaments' }) %>
<a class="back-link" href="/tournaments/<%= tournament.id %>">← Tournament details</a>
<section class="bracket-hero"><div><span class="eyebrow"><%= tournament.game.name %> · Live competition draw</span><h1><%= tournament.name %></h1><p>Follow every opponent, verified result, and winner progression from the first face to the final.</p></div><% if (tournament.stream?.status === 'LIVE') { %><a class="button" href="<%= tournament.stream.sourceUrl %>" target="_blank" rel="noreferrer">Watch live coverage ▶</a><% } %></section>
<% if (tournament.rulebook?.publishedAt) { %><section class="public-rulebook"><span>♜</span><div><strong><%= tournament.rulebook.title %></strong><p><%= tournament.rulebook.content %></p></div></section><% } %>
<% if (!tournament.matches.length) { %><section class="bracket-empty"><div class="bracket-empty-icon">⌁</div><span class="eyebrow">Draw pending</span><h2>The official first-round draw has not been published yet.</h2><p>Confirmed players will see their opponent here when the tournament operator releases the bracket.</p></section><% } else { %>
<section class="bracket-shell public-bracket"><div class="bracket-scroll"><div class="bracket-grid"><% for (let round = 1; round <= totalRounds; round += 1) { const roundMatches = tournament.matches.filter((match) => match.round === round); %><div class="bracket-round"><div class="bracket-round-title"><span><%= roundName(round, totalRounds) %></span><small><%= roundMatches.length %> fixtures</small></div><div class="bracket-round-matches"><% roundMatches.forEach((match) => { const winnerId = match.result?.winnerId; %><article class="bracket-match"><div class="bracket-match-meta"><span class="<%= match.status === 'IN_PROGRESS' ? 'live-label' : '' %>"><%= match.status.replaceAll('_', ' ') %></span><span><%= match.scheduledAt ? match.scheduledAt.toLocaleString() : 'Time pending' %></span></div><% [1, 2].forEach((slot) => { const participant = match.participants.find((entry) => entry.seed === slot); const score = participant ? match.result?.scores?.[participant.userId] : null; %><div class="bracket-player <%= participant && winnerId === participant.userId ? 'winner' : '' %> <%= participant && match.status === 'VERIFIED' && winnerId !== participant.userId ? 'eliminated' : '' %>"><span><%= participant?.user.displayName || 'Awaiting winner' %></span><strong><%= score ?? '—' %></strong></div><% }) %><a class="bracket-match-link" href="/matches/<%= match.id %>">Match details <span>→</span></a></article><% }) %></div></div><% } %></div></div></section><% } %>
<%- include('../partials/dashboard-footer') %>
