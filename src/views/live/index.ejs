<%- include('../partials/header', { title }) %>
<section class="page-intro live-page-intro"><span class="eyebrow">Live now</span><h1>Watch the arena unfold.</h1><p>Official coverage is enabled by tournament administrators and delivered from approved venue cameras or broadcast providers.</p></section>
<section class="live-stream-grid"><% if (!streams.length) { %><div class="message-card"><span class="live-dot"></span><h2>No live tournament coverage right now.</h2><p>Return when a tournament administrator activates an official stream.</p><a class="button" href="/tournaments">Explore tournaments</a></div><% } else { streams.forEach((stream) => { %><article class="live-stream-card"><div class="live-stream-frame"><iframe src="<%= stream.sourceUrl %>" title="<%= stream.title %>" allow="autoplay; fullscreen; picture-in-picture; camera; microphone" allowfullscreen></iframe></div><span class="live-badge"><i></i> Live</span><span class="eyebrow"><%= stream.tournament.game.name %></span><h2><%= stream.title %></h2><p><%= stream.tournament.name %></p><a href="/tournaments/<%= stream.tournament.id %>/bracket">Follow live draw →</a></article><% }) } %></section>
<%- include('../partials/footer') %>
