<%- include('../partials/dashboard-header', { title, active: 'dashboard' }) %>
<a class="back-link" href="/registrations">← Registration history</a>
<section class="registration-hero"><span class="eyebrow"><%= registration.tournament.game.name %> · <%= registration.tournament.status %></span><h1><%= registration.tournament.name %></h1><p><%= registration.tournament.description || 'Your competition registration record.' %></p></section>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<section class="registration-detail-grid"><div class="detail-panel"><span class="eyebrow">Registration record</span><h2>Your competition status</h2><dl class="detail-list"><div><dt>Registration status</dt><dd><b class="status-pill"><%= registration.status %></b></dd></div><div><dt>Payment status</dt><dd><%= registration.payment?.status || (registration.paymentAttempts?.[registration.paymentAttempts.length - 1]?.status || 'NOT_STARTED') %></dd></div><div><dt>Fee locked at registration</dt><dd><%= registration.feeAmount %> <%= registration.feeCurrency %></dd></div><div><dt>Registered on</dt><dd><%= new Date(registration.createdAt).toLocaleString() %></dd></div><div><dt>Receipt</dt><dd><% if (registration.receipt) { %><a href="/receipts/<%= registration.receipt.id %>"><%= registration.receipt.receiptNumber %></a><% } else { %>Issued after payment confirmation<% } %></dd></div></dl><% if (registration.receipt) { %><a class="button button-secondary" href="/receipts/<%= registration.receipt.id %>">Open payment receipt</a><% } %><% if (['PENDING', 'WAITLISTED'].includes(registration.status)) { %><form method="post" action="/payments/checkout/<%= registration.id %>" class="checkout-box"><strong>Secure checkout</strong><p>Your payable amount is <%= registration.feeAmount %> <%= registration.feeCurrency %>. You will be redirected to the configured payment provider.</p><button class="button" type="submit">Continue to payment <span>→</span></button></form><% } %></div><aside class="number-card"><span class="eyebrow">Official tournament number</span><strong><%= registration.tournamentNumber || 'Pending confirmation' %></strong><p>This number is issued only after server-side payment verification and eligibility confirmation. It is unique to this competition and will never be reassigned.</p><% if (['PENDING', 'WAITLISTED'].includes(registration.status)) { %><form method="post" action="/registrations/<%= registration.id %>/cancel"><button class="button button-secondary" type="submit">Cancel registration</button></form><% } %></aside></section>
<%- include('../partials/dashboard-footer') %>
