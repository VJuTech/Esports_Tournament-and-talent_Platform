<%- include('../../partials/dashboard-header', { title, active: 'live' }) %>
<section class="dashboard-welcome"><div><span class="dashboard-kicker">Broadcast operations</span><h1>Control live tournament coverage.</h1><p>Streams stay private until an administrator enables a live, public playback source for a tournament.</p></div><a class="dashboard-primary" href="/live">Open public live page <span>→</span></a></section>
<section class="live-admin-grid"><% if (!tournaments.length) { %><div class="dashboard-empty"><span>▶</span><strong>No published tournaments are ready for coverage.</strong><p>Publish a tournament first, then return here to activate its public live stream.</p><a class="dashboard-primary" href="/admin/tournaments">Manage tournaments</a></div><% } else { tournaments.forEach((tournament) => { %><article class="live-admin-card"><span class="dashboard-kicker"><%= tournament.game.name %></span><h2><%= tournament.name %></h2><p><b class="status-pill"><%= tournament.stream?.isEnabled ? 'PUBLIC LIVE ENABLED' : 'NOT ENABLED' %></b></p><p class="muted"><%= tournament.stream?.status || 'No broadcast source configured' %> · <%= tournament.stream?.provider || 'Configure camera provider' %></p><a class="button" href="/admin/tournaments/<%= tournament.id %>/operator"><%= tournament.stream?.isEnabled ? 'Manage live coverage' : 'Activate public live stream' %></a></article><% }) } %></section>
<%- include('../../partials/dashboard-footer') %>
