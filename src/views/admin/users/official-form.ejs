<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<a class="back-link" href="/admin/users">← Authorized accounts</a>
<section class="page-intro page-intro-small"><span class="eyebrow">Access provisioning</span><h1>Create a tournament official.</h1><p>The account receives a secure password hash and role-limited access to the official control room. Share the temporary password through an approved private channel.</p></section>
<section class="detail-panel admin-form-panel"><% if (error) { %><p class="alert alert-error"><%= error %></p><% } %><form class="form-grid form-grid-two" method="post" action="/admin/users/officials"><label>Full name<input name="displayName" value="<%= official?.displayName || '' %>" required></label><label>Email address<input name="email" type="email" value="<%= official?.email || '' %>" required></label><label>Role<select name="role" required><option value="TOURNAMENT_OFFICIAL" <%= official?.role === 'TOURNAMENT_OFFICIAL' ? 'selected' : '' %>>Tournament official</option><option value="REFEREE" <%= official?.role === 'REFEREE' ? 'selected' : '' %>>Referee</option></select></label><label>Temporary password<input name="password" type="password" minlength="12" autocomplete="new-password" required></label><button class="button" type="submit">Create official account</button></form></section>
<%- include('../../partials/dashboard-footer') %>
