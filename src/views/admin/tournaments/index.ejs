<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<div class="admin-heading"><div><span class="eyebrow">Competition calendar</span><h1>Manage tournaments</h1><p class="muted">Draft, publish, run, and preserve every competition.</p></div><a class="button" href="/admin/tournaments/new">Create tournament <span>+</span></a></div>
<div class="admin-table"><div class="admin-table-head"><span>Tournament</span><span>Game</span><span>Registrations</span><span>Status</span><span>Actions</span></div><% tournaments.forEach((tournament) => { %><div class="admin-table-row"><div><strong><%= tournament.name %></strong><small><%= tournament.code %> · <%= tournament.format %></small></div><span><%= tournament.game.name %></span><span><%= tournament._count.registrations %> / <%= tournament.capacity %></span><span><b class="status-pill"><%= tournament.status %></b></span><div class="row-actions"><a href="/admin/tournaments/<%= tournament.id %>/competition">Bracket</a><a href="/admin/tournaments/<%= tournament.id %>/edit">Edit</a><% if (tournament.status === 'DRAFT') { %><form method="post" action="/admin/tournaments/<%= tournament.id %>/transition"><input type="hidden" name="status" value="PUBLISHED"><button type="submit">Publish</button></form><% } else if (tournament.status === 'PUBLISHED') { %><form method="post" action="/admin/tournaments/<%= tournament.id %>/transition"><input type="hidden" name="status" value="IN_PROGRESS"><button type="submit">Open</button></form><% } else if (tournament.status === 'IN_PROGRESS') { %><form method="post" action="/admin/tournaments/<%= tournament.id %>/transition"><input type="hidden" name="status" value="COMPLETED"><button type="submit">Complete</button></form><% } %></div></div><% }) %></div>
<%- include('../../partials/dashboard-footer') %>
