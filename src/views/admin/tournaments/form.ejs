<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Competition configuration</span><h1><%= tournament ? 'Edit tournament' : 'Create a tournament' %></h1><p>Complete every operational detail before publishing to players.</p></section>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<% if (notice) { %><p class="alert alert-success"><%= notice %></p><% } %>
<form class="panel management-form" method="post" action="<%= tournament ? '/admin/tournaments/' + tournament.id : '/admin/tournaments' %>" enctype="multipart/form-data">
  <input type="hidden" name="clientTimezoneOffsetMinutes" id="clientTimezoneOffsetMinutes">
  <div class="form-grid form-grid-two"><label>Competition code<input name="code" required value="<%= tournament?.code || '' %>"></label><label>Tournament title<input name="name" required value="<%= tournament?.name || '' %>"></label><label>Game<select name="gameId" required><option value="">Select a game</option><% games.forEach((game) => { %><option value="<%= game.id %>" <%= tournament?.gameId === game.id ? 'selected' : '' %>><%= game.name %></option><% }) %></select><small class="upload-hint">Includes snooker, chess, tennis, football, table tennis, badminton, basketball, darts, and more.</small></label><label>Tournament image<input name="image" type="file" accept="image/jpeg,image/png,image/webp" <%= tournament ? '' : 'required' %>><small class="upload-hint">This image is displayed when the draft is published. JPG, PNG, or WebP · maximum 5 MB.</small></label><label>Competition format<select name="format" required><option <%= tournament?.format === 'SINGLE_ELIMINATION' ? 'selected' : '' %>>SINGLE_ELIMINATION</option><option <%= tournament?.format === 'ROUND_ROBIN' ? 'selected' : '' %>>ROUND_ROBIN</option></select></label><label>Participation<select name="participationType"><option value="INDIVIDUAL" <%= tournament?.participationType !== 'TEAM' ? 'selected' : '' %>>Individual</option><option value="TEAM" <%= tournament?.participationType === 'TEAM' ? 'selected' : '' %>>Team</option></select></label><label>Capacity<input name="capacity" type="number" min="1" required value="<%= tournament?.capacity || '' %>"></label><label>Registration fee<input name="entryFee" type="number" min="0" step="0.01" required value="<%= tournament?.entryFee || '0' %>"><small class="upload-hint">This is the amount a player pays to register for this tournament.</small></label><label>Currency<select name="currency" required><% ['NGN', 'USD', 'GBP', 'EUR', 'ZAR', 'GHS', 'KES'].forEach((currency) => { %><option value="<%= currency %>" <%= (tournament?.currency || 'NGN') === currency ? 'selected' : '' %>><%= currency === 'NGN' ? 'NGN — Nigerian Naira' : currency %></option><% }) %></select></label><label>Registration opens<input name="registrationOpensAt" type="datetime-local" required value="<%= tournament?.registrationOpensAt ? new Date(tournament.registrationOpensAt).toISOString().slice(0,16) : '' %>"></label><label>Registration closes<input name="registrationDeadline" type="datetime-local" required value="<%= tournament?.registrationDeadline ? new Date(tournament.registrationDeadline).toISOString().slice(0,16) : '' %>"></label><label>Tournament starts<input name="startsAt" type="datetime-local" required value="<%= tournament?.startsAt ? new Date(tournament.startsAt).toISOString().slice(0,16) : '' %>"></label><label>Tournament ends<input name="endsAt" type="datetime-local" required value="<%= tournament?.endsAt ? new Date(tournament.endsAt).toISOString().slice(0,16) : '' %>"></label><label>Minimum age<input name="eligibilityMinimumAge" type="number" min="0" value="<%= tournament?.eligibilityMinimumAge || '' %>"></label><label>Match duration (minutes)<input name="matchDurationMinutes" type="number" min="1" value="<%= tournament?.matchDurationMinutes || '' %>"></label><label class="field-wide">Description<textarea name="description" rows="3"><%= tournament?.description || '' %></textarea></label><label class="field-wide">Eligibility requirements<textarea name="eligibilityRequirements" rows="3"><%= tournament?.eligibilityRequirements || '' %></textarea></label><label>Scoring rules<textarea name="scoringRules" rows="3"><%= tournament?.scoringRules || '' %></textarea></label><label>Scheduling rules<textarea name="schedulingRules" rows="3"><%= tournament?.schedulingRules || '' %></textarea></label><label>Reporting rules<textarea name="reportingRules" rows="3"><%= tournament?.reportingRules || '' %></textarea></label><label>Prize information<textarea name="prizeInformation" rows="3"><%= tournament?.prizeInformation || '' %></textarea></label><label>Refund/cancellation policy<textarea name="refundPolicy" rows="3"><%= tournament?.refundPolicy || '' %></textarea></label><label>Published terms<textarea name="terms" rows="3"><%= tournament?.terms || '' %></textarea></label><label>Dispute deadline<input name="disputeDeadline" type="datetime-local" value="<%= tournament?.disputeDeadline ? new Date(tournament.disputeDeadline).toISOString().slice(0,16) : '' %>"></label></div><button class="button" type="submit"><%= tournament ? 'Save tournament' : 'Save draft' %> <span>→</span></button>
</form>
<% if (tournament?.status === 'DRAFT') { %>
<form class="publish-tournament-form" method="post" action="/admin/tournaments/<%= tournament.id %>/transition">
  <input type="hidden" name="status" value="PUBLISHED">
  <button class="button" type="submit">Publish tournament <span>→</span></button>
</form>
<% } %>
<%- include('../../partials/dashboard-footer') %>
