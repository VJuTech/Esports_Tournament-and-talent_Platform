<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Private talent operations</span><h1>Scout with context.</h1><p>Evaluations and decisions are restricted to authorized recruitment staff and preserved as an internal history.</p></section>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<section class="detail-panel"><h2>Record evaluation</h2><form class="form-grid form-grid-two" method="post" action="/admin/scouting/evaluations"><label>Player<select name="playerId" required><option value="">Select player</option><% players.forEach((player) => { %><option value="<%= player.id %>"><%= player.displayName %> · <%= player.email %></option><% }) %></select></label><label>Rating (1–10)<input type="number" name="rating" min="1" max="10" required></label><label>Strengths<textarea name="strengths" required></textarea></label><label>Concerns<textarea name="concerns"></textarea></label><label>Internal notes<textarea name="notes"></textarea></label><button class="button" type="submit">Save restricted evaluation</button></form></section>
<section class="detail-panel"><h2>Communicate a selection decision</h2><form class="form-grid form-grid-two" method="post" action="/admin/scouting/decisions"><label>Player<select name="playerId" required><option value="">Select player</option><% players.forEach((player) => { %><option value="<%= player.id %>"><%= player.displayName %></option><% }) %></select></label><label>Cycle<input name="cycle" placeholder="2027 national team" required></label><label>Status<select name="status"><option>SHORTLISTED</option><option>SELECTED</option><option>RESERVE</option><option>REJECTED</option></select></label><label>Criteria<input name="criteria" required></label><label>Notes<textarea name="notes"></textarea></label><button class="button" type="submit">Record decision and notify player</button></form></section>
<section class="admin-table"><div class="admin-table-head"><span>Player</span><span>Scout</span><span>Rating</span><span>Created</span></div><% evaluations.forEach((evaluation) => { %><div class="admin-table-row"><strong><%= evaluation.player.displayName %></strong><span><%= evaluation.scout.displayName %></span><span><%= evaluation.rating %>/10</span><small><%= evaluation.createdAt.toLocaleDateString() %></small></div><% }) %></section>
<%- include('../../partials/dashboard-footer') %>
