<%- include('../partials/dashboard-header', { title, active: 'manage' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Operations</span><h1><%= heading %>.</h1><% if (title === 'User accounts') { %><a class="button" href="/admin/users/officials/new">Create tournament official</a><% } %></section>
<% if (typeof error !== 'undefined' && error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %><% if (typeof notice !== 'undefined' && notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<section class="admin-table"><div class="admin-table-head"><% columns.forEach((column) => { %><span><%= column.replaceAll('_', ' ') %></span><% }) %><% if (typeof showUserActions !== 'undefined' && showUserActions) { %><span>Actions</span><% } %></div><% records.forEach((record) => { %><div class="admin-table-row"><% columns.forEach((column) => { %><span><%= record[column] instanceof Date ? record[column].toLocaleString() : record[column] || '—' %></span><% }) %><% if (typeof showUserActions !== 'undefined' && showUserActions) { %><div class="row-actions"><% if (record.id === currentUser?.id) { %><span class="muted">Current account</span><% } else if (record.accountStatus === 'ACTIVE') { %><form method="post" action="/admin/users/<%= record.id %>/suspend"><button type="submit">Suspend</button></form><form method="post" action="/admin/users/<%= record.id %>/delete" data-confirm="Delete this account? It will be disabled, and linked history will remain available for records and audit purposes."><button type="submit">Delete</button></form><% } else if (record.accountStatus === 'SUSPENDED') { %><form method="post" action="/admin/users/<%= record.id %>/unsuspend"><button type="submit">Unsuspend</button></form><form method="post" action="/admin/users/<%= record.id %>/delete" data-confirm="Delete this account? It will be disabled, and linked history will remain available for records and audit purposes."><button type="submit">Delete</button></form><% } else { %><span class="muted">Deleted</span><% } %></div><% } %></div><% }) %></section>
<%- include('../partials/dashboard-footer') %>
