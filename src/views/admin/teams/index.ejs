<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Roster studio</span><h1>Build teams that last.</h1><p>Membership records are append-only so selected, invited, reserve, accepted, and departed history remains available.</p></section>
<section class="detail-panel"><h2>Create team</h2><form class="form-grid form-grid-two" method="post" action="/admin/teams"><label>Team name<input name="name" required></label><label>Game<select name="gameId" required><option value="">Select game</option><% games.forEach((game) => { %><option value="<%= game.id %>"><%= game.name %></option><% }) %></select></label><button class="button" type="submit">Create team</button></form></section>
<div class="feature-grid"><% teams.forEach((team) => { %><article class="feature-card"><span class="eyebrow"><%= team.game.name %></span><h2><%= team.name %></h2><p>Manager: <%= team.manager?.displayName || 'Unassigned' %></p><div class="record-list"><% team.memberships.forEach((membership) => { %><div class="record-row"><div><strong><%= membership.user.displayName %></strong><span><%= membership.joinedAt.toLocaleDateString() %></span></div><b class="status-pill"><%= membership.status %></b></div><% }) %></div></article><% }) %></div>
<%- include('../../partials/dashboard-footer') %>
