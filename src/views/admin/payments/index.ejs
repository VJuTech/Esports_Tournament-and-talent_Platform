<%- include('../../partials/dashboard-header', { title, active: 'finance' }) %>
<div class="admin-heading"><div><span class="eyebrow">Finance operations</span><h1>Payment reconciliation</h1><p class="muted">Review provider attempts, internal records, and refund actions.</p></div></div>
<% if (typeof error !== 'undefined' && error) { %><p class="alert alert-error"><%= error %></p><% } %>
<div class="admin-table payment-table"><div class="admin-table-head"><span>Reference</span><span>Participant</span><span>Amount</span><span>Status</span><span>Action</span></div><% if (!attempts.length) { %><div class="admin-empty">No payment attempts have been recorded.</div><% } else { attempts.forEach((attempt) => { %><div class="admin-table-row"><div><strong><%= attempt.providerReference %></strong><small><%= attempt.provider %> · <%= new Date(attempt.createdAt).toLocaleString() %></small></div><div><strong><%= attempt.registration.user.displayName %></strong><small><%= attempt.registration.tournament.name %></small></div><span><%= attempt.amount %> <%= attempt.currency %></span><span><b class="status-pill"><%= attempt.status %></b></span><div class="row-actions"><% if (['VERIFIED', 'SUCCESSFUL'].includes(attempt.status)) { %><form method="post" action="/admin/payments/<%= attempt.id %>/refund"><button type="submit">Request refund</button></form><% } else { %><span class="muted">No action</span><% } %></div></div><% }) } %></div>
<%- include('../../partials/dashboard-footer') %>
