<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Game catalogue</span><h1><%= game ? 'Edit a game' : 'Add a supported game' %></h1><p>Give players and managers a clear foundation for competition.</p></section>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<form class="panel management-form" method="post" action="<%= game ? '/admin/games/' + game.id : '/admin/games' %>"><div class="form-grid form-grid-two"><label>Game name<input name="name" required value="<%= game?.name || '' %>"></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+" value="<%= game?.slug || '' %>"></label><label class="field-wide">Description<textarea name="description" rows="4"><%= game?.description || '' %></textarea></label><label>Supported mode<input name="supportedMode" placeholder="5v5, solo, duo" value="<%= game?.supportedMode || '' %>"></label><label>Competition formats<input name="formats" placeholder="Single elimination, Round robin" value="<%= Array.isArray(game?.formats) ? game.formats.join(', ') : '' %>"></label><label>Image URL<input name="imageUrl" type="url" value="<%= game?.imageUrl || '' %>"></label><label>Official rules URL<input name="rulesUrl" type="url" value="<%= game?.rulesUrl || '' %>"></label></div><button class="button" type="submit"><%= game ? 'Save changes' : 'Create game' %> <span>→</span></button></form>
<%- include('../../partials/dashboard-footer') %>
