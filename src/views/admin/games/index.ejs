<%- include('../../partials/dashboard-header', { title, active: 'manage' }) %>
<div class="admin-heading"><div><span class="eyebrow">Catalogue control</span><h1>Supported games</h1><p class="muted">Deactivation preserves historical tournaments and results.</p></div><a class="button" href="/admin/games/new">Add a game <span>+</span></a></div>
<div class="admin-table"><div class="admin-table-head"><span>Game</span><span>Mode</span><span>Formats</span><span>Status</span><span>Actions</span></div><% games.forEach((game) => { %><div class="admin-table-row"><div class="table-game"><% if (game.imageUrl) { %><img src="<%= game.imageUrl %>" alt=""><% } %><span><strong><%= game.name %></strong><small><%= game.slug %></small></span></div><span><%= game.supportedMode || 'Not set' %></span><span><%= Array.isArray(game.formats) ? game.formats.join(', ') : 'Not set' %></span><span><b class="status-pill <%= game.isActive ? '' : 'status-muted' %>"><%= game.isActive ? 'Active' : 'Inactive' %></b></span><div class="row-actions"><a href="/admin/games/<%= game.id %>/edit">Edit</a><form method="post" action="/admin/games/<%= game.id %>/toggle"><button type="submit"><%= game.isActive ? 'Deactivate' : 'Activate' %></button></form></div></div><% }) %></div>
<%- include('../../partials/dashboard-footer') %>
