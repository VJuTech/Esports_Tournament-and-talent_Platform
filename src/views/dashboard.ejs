<%- include('partials/dashboard-header', { title, active: 'dashboard' }) %>
<section class="dashboard-welcome"><div><span class="dashboard-kicker">Player dashboard</span><h1>Welcome back, <%= profile.displayName %>.</h1><p>Track your competitions, build your record, and find your next opportunity.</p></div><a class="dashboard-primary" href="/tournaments">Explore competitions <span>→</span></a></section>
<section class="dashboard-hero-card"><div class="dashboard-hero-copy"><span class="dashboard-kicker">Your competitive record</span><h2>Every match is part of your story.</h2><p>Keep your profile current and turn tournament participation into verified progress that scouts and teams can trust.</p><a class="dashboard-outline" href="/profile">Complete your profile <span>→</span></a></div><div class="dashboard-hero-orbit"><span>CL</span><i></i><b></b></div></section>
<section class="dashboard-stat-grid"><article><span>Competitions joined</span><strong><%= profile.registrations.length %></strong><small>Participation history</small></article><article><span>Verified rankings</span><strong><%= profile.rankings.length %></strong><small>Official results</small></article><article><span>Game identities</span><strong><%= profile.gameProfiles.length %></strong><small>Connected profiles</small></article><article><span>Team status</span><strong><%= profile.teamMembers.length ? 'On' : 'Free' %></strong><small><%= profile.teamMembers.length ? profile.teamMembers[0].team.name : 'Open to opportunities' %></small></article></section>
<section class="dashboard-section-heading"><div><span class="dashboard-kicker">Your competitions</span><h2>Recent activity</h2></div><a href="/registrations">View registration history →</a></section>
<section class="dashboard-activity-list"><% if (!profile.registrations.length) { %><div class="dashboard-empty"><span>◌</span><strong>Your competition history starts here.</strong><p>Browse published tournaments and register for your next challenge.</p><a href="/tournaments">Browse tournaments →</a></div><% } else { %><% profile.registrations.slice(0, 5).forEach((registration) => { %><a class="dashboard-activity-row" href="/registrations/<%= registration.id %>"><span class="activity-game">CL</span><div><strong><%= registration.tournament.name %></strong><small><%= registration.tournamentNumber || 'Number pending' %> · <%= registration.status %></small></div><span class="activity-date"><%= new Date(registration.createdAt).toLocaleDateString() %></span></a><% }) %><% } %></section>
<%- include('partials/dashboard-footer') %>
