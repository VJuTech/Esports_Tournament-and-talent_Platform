<%- include('../partials/dashboard-header', { title, active: 'official' }) %>
<section class="official-hero"><div><span class="dashboard-kicker">Tournament official control room</span><h1>Own every result.</h1><p>Record the mapped winner and loser. The verified result advances the winner into the next face of the physical tournament automatically.</p></div><a class="dashboard-primary" href="/tournaments">View public draws <span>→</span></a></section>
<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<section class="official-explainer"><span>⌁</span><p>Only the two players mapped to a fixture can be selected. A submitted official result is permanent, audited, and immediately updates the public bracket.</p></section>
<% if (liveStreams.length) { %><section class="official-live-section"><div><span class="dashboard-kicker">Administrator-enabled venue coverage</span><h2>Camera controls are ready.</h2><p>Select the tournament arena you are covering. Opening the camera never makes it public by itself; only the administrator-enabled broadcast can be viewed by visitors.</p></div><div class="official-live-actions"><% liveStreams.forEach((stream) => { %><a class="dashboard-primary" href="/official/tournaments/<%= stream.tournamentId %>/camera">Open <%= stream.tournament.name %> camera <span>▶</span></a><% }) %></div></section><% } else { %><section class="official-live-section official-live-section-disabled"><div><span class="dashboard-kicker">Venue camera</span><h2>Camera controls are locked.</h2><p>An administrator must activate a live tournament stream before officials can open a camera or broadcast from the arena.</p></div></section><% } %>
<section class="official-match-grid"><% if (!matches.length) { %><div class="dashboard-empty"><span>◌</span><strong>No physical fixtures need an official result.</strong><p>Newly generated brackets and scheduled matches will appear here.</p></div><% } else { matches.forEach((match) => { %><article class="official-match-card"><div class="official-match-meta"><span><%= match.tournament.game.name %> · Round <%= match.round %></span><b><%= match.status.replaceAll('_', ' ') %></b></div><h2><%= match.tournament.name %></h2><p><%= match.scheduledAt ? match.scheduledAt.toLocaleString() : 'Schedule to be confirmed' %></p><% if (match.tournament.stream?.isEnabled && match.tournament.stream.status === 'LIVE' && match.tournament.stream.ingestUrl) { %><a class="official-camera-link" href="/official/tournaments/<%= match.tournamentId %>/camera">Open venue camera ▶</a><% } %><form class="official-result-form" method="post" action="/official/matches/<%= match.id %>/result"><label>Winner<select name="winnerId" required><option value="">Select winner</option><% match.participants.forEach((participant) => { %><option value="<%= participant.userId %>"><%= participant.user.displayName %></option><% }) %></select></label><label>Winner score<input name="winnerScore" type="number" min="0" required></label><label>Loser<select name="loserId" required><option value="">Select loser</option><% match.participants.forEach((participant) => { %><option value="<%= participant.userId %>"><%= participant.user.displayName %></option><% }) %></select></label><label>Loser score<input name="loserScore" type="number" min="0" required></label><label class="official-evidence">Evidence URL (optional)<input name="evidenceUrl" type="url" placeholder="Result sheet or video evidence"></label><button class="button" type="submit">Verify result and advance winner</button></form></article><% }) } %></section>
<%- include('../partials/dashboard-footer') %>
