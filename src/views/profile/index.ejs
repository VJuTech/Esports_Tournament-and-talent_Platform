<%- include('../partials/dashboard-header', { title, active: 'profile' }) %>
<section class="page-intro page-intro-small"><span class="eyebrow">Your player identity</span><h1>Build a profile worth discovering.</h1><p>Keep your permitted information current and give every result the context it deserves.</p></section>
<% if (message) { %><p class="alert alert-success"><%= message %></p><% } %><% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<form method="post" action="/profile" class="profile-layout">
  <div class="profile-main panel"><div class="panel-heading"><span class="eyebrow">Identity</span><h2>Profile details</h2></div><div class="form-grid form-grid-two"><label>Display name<input name="displayName" value="<%= profile.displayName %>" required maxlength="80"></label><label>Country<input name="country" value="<%= profile.country || '' %>" required maxlength="80"></label><label class="field-wide">Profile image URL<input name="profileImage" type="url" value="<%= profile.profileImage || '' %>" placeholder="https://..."></label><label class="field-wide">Eligibility notes<textarea name="eligibilityInfo" rows="4"><%= profile.eligibilityInfo?.notes || '' %></textarea></label></div><div class="panel-heading subheading"><span class="eyebrow">Game identities</span><h2>Supported game profiles</h2></div><div class="game-profile-list"><% games.forEach((game, index) => { const connected = profile.gameProfiles.find((item) => item.gameId === game.id); %><div class="game-profile-row"><div><strong><%= game.name %></strong><span><%= connected ? 'Connected' : 'Not connected' %></span></div><input type="hidden" name="gameId" value="<%= game.id %>"><input name="inGameId" value="<%= connected ? connected.inGameId : '' %>" placeholder="In-game identifier" aria-label="<%= game.name %> identifier"></div><% }) %></div><button class="button" type="submit">Save profile <span>→</span></button></div>
  <aside class="profile-side"><div class="panel profile-summary"><div class="avatar"><%= profile.displayName.slice(0, 1).toUpperCase() %></div><h2><%= profile.displayName %></h2><p><%= profile.email %></p><span class="verified-tag">Email verified</span><dl><div><dt>Country</dt><dd><%= profile.country || 'Add country' %></dd></div><div><dt>Scout status</dt><dd><%= profile.scoutStatus || 'Not assessed' %></dd></div><div><dt>Team</dt><dd><%= profile.teamMembers.length ? profile.teamMembers[0].team.name : 'Free agent' %></dd></div></dl></div><div class="panel privacy-note"><span class="eyebrow">Your privacy</span><p>Only information needed for competition, payments, and permitted scouting is collected.</p></div></aside>
</form>
<%- include('../partials/dashboard-footer') %>
