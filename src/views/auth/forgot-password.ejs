<%- include('../partials/header', { title }) %>
<section class="auth-shell single-auth"><div class="auth-card"><span class="eyebrow">Account recovery</span><h2>Reset your password</h2><p class="muted">Generate a secure, time-limited reset code for your account.</p><% if (message) { %><p class="alert alert-success"><%= message %></p><% } %><% if (error) { %><p class="alert alert-error"><%= error %></p><% } %><% if (emailDeliveryWarning) { %><p class="alert alert-error"><%= emailDeliveryWarning %></p><% } %><form method="post" action="/auth/forgot-password" class="form-grid"><label>Email address<input name="email" type="email" required autocomplete="email" value="<%= email || '' %>"></label><button class="button" type="submit">Generate reset code</button></form><% if (resetCode) { %><div class="verification-code"><%= resetCode %></div><p class="muted">Development code, valid for 15 minutes.</p><form method="post" action="/auth/reset-password-code" class="form-grid"><input type="hidden" name="email" value="<%= email %>"><label>Reset code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label><label>New password<input name="password" type="password" minlength="8" autocomplete="new-password" required></label><label>Confirm new password<input name="passwordConfirmation" type="password" minlength="8" autocomplete="new-password" required></label><button class="button" type="submit">Save new password</button></form><% } %><p class="form-footnote"><a href="/auth/login">Back to sign in</a></p></div></section>
<%- include('../partials/footer') %>
