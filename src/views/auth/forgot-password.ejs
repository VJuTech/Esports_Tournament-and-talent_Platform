<%- include('../partials/header', { title }) %>
<section class="auth-shell single-auth"><div class="auth-card"><span class="eyebrow">Account recovery</span><h2>Reset your password</h2><p class="muted">Enter your account email and we will send a secure, time-limited reset link.</p><% if (message) { %><p class="alert alert-success"><%= message %></p><% } %><% if (error) { %><p class="alert alert-error"><%= error %></p><% } %><form method="post" action="/auth/forgot-password" class="form-grid"><label>Email address<input name="email" type="email" required autocomplete="email"></label><button class="button" type="submit">Send reset link</button></form><p class="form-footnote"><a href="/auth/login">Back to sign in</a></p></div></section>
<%- include('../partials/footer') %>
