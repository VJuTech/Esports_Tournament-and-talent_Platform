<%- include('../partials/header', { title }) %>
<section class="auth-shell single-auth"><div class="auth-card"><span class="eyebrow">New credentials</span><h2>Choose a new password</h2><% if (error) { %><p class="alert alert-error"><%= error %></p><% } %><form method="post" action="/auth/reset-password/<%= token %>" class="form-grid"><label>New password<input name="password" type="password" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input name="passwordConfirmation" type="password" required minlength="8" autocomplete="new-password"></label><button class="button" type="submit">Update password</button></form></div></section>
<%- include('../partials/footer') %>
