<%- include('../partials/dashboard-header', { title, active: 'dashboard' }) %>
<a class="back-link" href="/registrations/<%= registration.id %>">← Back to registration</a>
<section class="detail-panel checkout-box">
  <span class="eyebrow">Bank transfer payment</span>
  <h1>Complete your payment</h1>
  <p>Transfer the registration fee below and use the reference shown so the payment can be matched to your registration.</p>

  <dl class="detail-list">
    <div>
      <dt>Amount</dt>
      <dd><strong><%= paymentAmount %> <%= paymentCurrency %></strong></dd>
    </div>
    <div>
      <dt>Bank</dt>
      <dd><%= tournament.paymentBankName %></dd>
    </div>
    <div>
      <dt>Account name</dt>
      <dd><%= tournament.paymentAccountName %></dd>
    </div>
    <div>
      <dt>Account number</dt>
      <dd><%= tournament.paymentAccountNumber %></dd>
    </div>
    <div>
      <dt>Account type</dt>
      <dd><%= tournament.paymentAccountType %></dd>
    </div>
    <div>
      <dt>Payment reference</dt>
      <dd><strong><%= paymentReference %></strong></dd>
    </div>
  </dl>

  <% if (tournament.paymentInstructions) { %>
    <p><strong>Instructions:</strong> <%= tournament.paymentInstructions %></p>
  <% } %>

  <% if (attempt.status === 'PROCESSING') { %>
    <p class="alert alert-success" role="status">Your payment has been reported and is awaiting finance confirmation. Your registration will be confirmed after the transfer is verified.</p>
  <% } else { %>
    <p class="muted">After transferring the fee, report it below. Your entry is confirmed only after finance verifies the transfer.</p>
    <form method="post" action="/payments/checkout/<%= registration.id %>/confirm" class="form-grid">
      <input type="hidden" name="attemptId" value="<%= attempt.id %>">
      <label>Bank transfer reference (optional)<input name="transferReference" maxlength="120" autocomplete="off"></label>
      <button class="button" type="submit">I have made Payment</button>
    </form>
  <% } %>
  <a class="button button-secondary" href="/registrations/<%= registration.id %>">Return to registration</a>
</section>
<%- include('../partials/dashboard-footer') %>
